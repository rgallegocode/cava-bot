# Copia este archivo como .env y rellena tus claves (.env está en .gitignore y nunca se sube)

# Modelo: gemini (por defecto) o hf (Qwen2.5 vía Hugging Face, requiere HF_TOKEN)
MODEL_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://newsapi.org/account (opcional: sin ella el agente busca en la web)
NEWS_API_KEY=
# Solo si MODEL_PROVIDER=hf: https://huggingface.co/settings/tokens
HF_TOKEN=

# Solo para daily_bulletin.py
TELEGRAM_TOKEN=
CHAT_ID=
# 1 = imprime el boletín en vez de enviarlo
DRY_RUN=1
