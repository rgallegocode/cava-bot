# Copy this file to .env and fill in your keys (.env is git-ignored and never committed)

# LLM provider: groq (default), gemini or hf (Qwen2.5 via Hugging Face, requires HF_TOKEN)
MODEL_PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=
# Only if MODEL_PROVIDER=gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://newsapi.org/account (optional: without it the agent falls back to web search)
NEWS_API_KEY=
# Only if MODEL_PROVIDER=hf: https://huggingface.co/settings/tokens
HF_TOKEN=

# Only for daily_bulletin.py
TELEGRAM_TOKEN=
CHAT_ID=
# 1 = print the bulletin instead of sending it
DRY_RUN=1
